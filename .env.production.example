# konak — production environment for konaq.kz.
#
# Copy to `.env` IN THE REPO ROOT and fill in. That path matters: `.env` is
# gitignored, so it survives every `git pull`, and docker/deploy.sh passes it
# as both --env-file (for ${...} interpolation in the compose file) and as the
# app container's env_file.
#
#   cp .env.production.example .env && chmod 600 .env
#
# Nothing in here is ever baked into an image — the build runs with
# SKIP_ENV_VALIDATION=1 precisely so these values are supplied at run time.

# ── Postgres ──────────────────────────────────────────────────────────────
# Read by the compose file to create the database, and by DATABASE_URL below.
# These take effect ONLY on a fresh volume; changing the password afterwards
# requires `ALTER ROLE konak WITH PASSWORD '...'` inside the container.
POSTGRES_USER=konak
POSTGRES_PASSWORD=            # REQUIRED — generate: openssl rand -base64 24
POSTGRES_DB=konak

# The host is `db`, the compose service name, resolved over the `internal`
# network. NOT localhost and NOT 127.0.0.1 — from inside the app container
# those mean the app container itself. The password must match the line above.
DATABASE_URL=postgresql://konak:CHANGE_ME@db:5432/konak?schema=public

# ── Better Auth ───────────────────────────────────────────────────────────
# Signs session tokens. Rotating it logs everyone out.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The canonical public origin, and the base every OAuth callback URL is built
# from. It is https and it is the APEX — www.konaq.kz permanently redirects
# here (see docker/Caddyfile), so a session or callback bound to www would
# never be seen by the app.
BETTER_AUTH_URL=https://konaq.kz

# ── Field-level encryption ────────────────────────────────────────────────
# Exactly 32 bytes of base64. env.mjs refuses to start on anything else, by
# design: IdentityDocument.numberEncrypted must never silently fall back to
# plaintext.
#   openssl rand -base64 32
# ⚠️ BACK THIS UP SOMEWHERE OTHER THAN THIS SERVER. It is not derivable, and
# losing it loses every value ever encrypted with it — the database rows remain
# but become permanently unreadable.
FIELD_ENCRYPTION_KEY=

NODE_ENV=production

# ── File storage ──────────────────────────────────────────────────────────
# `filesystem` needs no external account. The path is the mount point of the
# `storage` named volume declared in docker/compose/prod.yml — the compose file
# also sets it explicitly, so these two must not disagree.
#
# Do NOT point this inside the image or the repo: the container filesystem is
# replaced on every deploy, so uploads written there are deleted by the next
# release.
STORAGE_PROVIDER=filesystem
STORAGE_FS_ROOT=/data/storage

# S3 / MinIO / R2 — the only prepared provider that keeps objects private AND
# signs reads, so it is the one to move to when the volume outgrows the box.
# Setting STORAGE_PROVIDER=s3 makes all four of these required at startup.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=              # set for MinIO and R2, absent for AWS itself

# ── Channel credentials ───────────────────────────────────────────────────
# Where the outbox worker and the app read a channel connection's secret from.
# ONE FILE PER CONNECTION, named by that connection's `credentialsRef` with a
# `.json` suffix, holding a flat object of strings — whatever fields the vendor
# asks for:
#
#   /etc/konak/channel-secrets/channex-live.json
#   { "apiKey": "…", "propertyId": "…" }
#
# A directory rather than a variable per vendor, on purpose: rotating one
# secret rewrites one file, and nothing ends up in `docker inspect` output.
# Keep it OUTSIDE the repo and outside any volume that gets backed up casually;
# `chmod 600` each file. It is mounted read-only into both the app and the
# worker at /run/secrets/channels, and CHANNEL_SECRETS_DIR inside the
# containers is set by the compose file, not here.
#
# The default below is what the compose file uses when this is unset. It need
# not exist yet: a connection whose secret cannot be read refuses to go ACTIVE
# and says so on the property's setup screen.
# CHANNEL_SECRETS_HOST_DIR=/etc/konak/channel-secrets

# ── OAuth (optional) ──────────────────────────────────────────────────────
# A provider is registered only when BOTH halves are set. Register the callback
# against the apex origin:
#   https://konaq.kz/api/auth/callback/github
#   https://konaq.kz/api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Redis (not yet used) ──────────────────────────────────────────────────
# The compose file defines a redis service behind the `redis` profile, so it is
# one flag away. Nothing imports a client today; adding this variable alone
# changes nothing until src/env.mjs declares it and some code reads it.
# REDIS_URL=redis://redis:6379
