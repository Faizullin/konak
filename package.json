{
  "name": "konak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bundle": "tsx scripts/bundle.mts",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:studio": "prisma studio",
    "outbox": "tsx --conditions=react-server scripts/outbox-worker.mts",
    "auth:generate": "npm run db:generate && SKIP_ENV_VALIDATION=1 npx auth@latest generate --config src/server/auth.ts --output prisma/schema/identity.prisma",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:server": "STORAGE_FS_ROOT=.storage-test tsx --conditions=react-server --test --test-concurrency=1 \"tests/server/**/*.test.ts\"",
    "e2e:db": "tsx scripts/e2e-db.mts",
    "test:e2e": "npm run e2e:db && playwright test",
    "test:e2e:ui": "npm run e2e:db && playwright test --ui",
    "report:ui": "npm run e2e:db && playwright test --project=report && tsx scripts/report.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@ebay/nice-modal-react": "^1.2.13",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.7.2",
    "@trpc/react-query": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "client-only": "0.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.555.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.5",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "sass": "^1.104.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true,
    "fsevents": true
  }
}
