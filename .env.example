# Database — Postgres, in Docker:
# `docker compose -f docker/compose/db.yml up -d`, then `npm run db:migrate`.
DATABASE_URL="postgresql://konak:konak@localhost:5432/konak?schema=public"


# Better Auth — generate a secret with `npx auth@latest secret`.
# BETTER_AUTH_URL is the origin OAuth callback URLs are built from.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000


# Field-level encryption — 32 bytes of base64, for `IdentityDocument.numberEncrypted`
# and anything else stored under it. Generate one with: openssl rand -base64 32
# Losing this key loses every value encrypted with it; it is not derivable.
FIELD_ENCRYPTION_KEY=


# OAuth — optional. A provider is registered only when both halves are set.
# GitHub → https://github.com/settings/developers
#          callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google → https://console.cloud.google.com/apis/credentials
#          callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


NODE_ENV=development


# File storage — where attachments live. Defaults to `filesystem`, which needs
# no account and no service, so everything below is optional until you switch.
# Only the selected provider's variables are required; `env.mjs` refuses to
# start without them and names the ones missing.
# STORAGE_PROVIDER=filesystem
# Must stay outside `public/`, or Next serves every stored file to anyone.
# STORAGE_FS_ROOT=.storage
#
# S3 — also MinIO, Cloudflare R2, Backblaze B2. The only prepared provider that
# keeps objects private AND signs reads, so identity documents can live here.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # set for MinIO and R2, absent for AWS itself
#
# Cloudinary and Vercel Blob serve public URLs, so neither may hold a passport
# scan — refused at startup by `KIND_REQUIRES`, not at upload.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# BLOB_READ_WRITE_TOKEN=

# Build — set to "true" to generate a standalone output for Docker / containerized deployments
# BUILD_STANDALONE=true
