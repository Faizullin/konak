# Database — SQLite, no service to run. The file is created by
# `npx prisma migrate dev` (or `npm run db:push`).
DATABASE_URL="file:./dev.db"


# Clerk — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → add an endpoint, subscribed to
# user.created / user.updated / user.deleted / session.created.
# In development, run `npm run tunnel` and use:
#   https://konak-tunnel-web.loca.lt/api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=


NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard


NODE_ENV=development

# Development — comma-separated allowed origins for cross-origin dev requests / tunnels
ALLOWED_DEV_ORIGINS=konak-tunnel-web.loca.lt,*.loca.lt

# Build — set to "true" to generate a standalone output for Docker / containerized deployments
# BUILD_STANDALONE=true

