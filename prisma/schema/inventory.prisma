// inventory
//
// The decision the whole system turns on: **a guest books a room type, not a
// room.** Availability is counted against `RoomType`; a physical `Room` is
// assigned at or before check-in. Rates, restrictions and channel mappings all
// hang off the type, never off a room — model it the other way and every rate
// plan and every OTA push has to be rewritten.
//
// Date columns here are date-only: UTC midnight of the property-local day. A
// nightly rate belongs to a calendar day, not an instant.

model RoomType {
  id            Int     @id @default(autoincrement())
  propertyId    Int
  // Named by the public availability widget, which has no session to check.
  publicId      String  @unique @default(uuid(7))
  name          String
  // Stable short code. This is what a channel manager maps to an OTA's own id,
  // so it outlives renaming the type.
  code          String
  description   String?
  // ROOM or BED — the whole discriminator. A BED type prices, maps and counts
  // exactly like a ROOM type; only what a stay points at differs. See
  // plans/inventory-units.md.
  unit          String  @default("ROOM")
  // The rate is quoted for `baseOccupancy`; anyone beyond it is priced by the
  // plan's extra-person amounts.
  baseOccupancy Int     @default(2)
  maxOccupancy  Int     @default(2)
  maxAdults     Int     @default(2)
  maxChildren   Int     @default(0)
  sizeSqm       Int?
  position      Int     @default(0)

  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms           Room[]
  inventory       RoomTypeInventory[]
  holds           InventoryHold[]
  stays           RoomStay[]
  channelMappings ChannelMapping[]

  @@unique([propertyId, code])
  @@index([propertyId, archivedAt])
  @@map("room_types")
}

model Room {
  id         Int     @id @default(autoincrement())
  propertyId Int
  roomTypeId Int
  number     String
  floor      String?
  // Housekeeping state, and a state of *now* — not of a date. Set to DIRTY
  // automatically at check-out. `OUT_OF_ORDER` does **not** reduce what is for
  // sale: a room broken this morning may be fixed by March, and letting a
  // current flag shrink a future night would be wrong in the direction that
  // loses bookings. A room genuinely out of service for a period is a block on
  // those nights — `RoomTypeInventory`.
  status     String  @default("CLEAN") // CLEAN, DIRTY, IN_PROGRESS, INSPECTED, OUT_OF_ORDER
  notes      String?

  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  stays             RoomStay[]
  beds              Bed[]
  housekeepingTasks HousekeepingTask[]
  maintenanceIssues MaintenanceIssue[]
  lockDevices       LockDevice[]

  @@unique([propertyId, number])
  @@index([propertyId, roomTypeId])
  @@index([propertyId, status])
  @@map("rooms")
}

// A bookable bunk inside a room, for a type whose unit is BED. Belongs to the
// room, not the type — a bed's identity is where it physically stands.
model Bed {
  id       Int    @id @default(autoincrement())
  roomId   Int
  // Guest-facing: "Bunk 1", "Top near window" — never confusable with a room
  // number.
  label    String
  position Int    @default(0)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  room  Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stays RoomStay[]

  @@unique([roomId, label])
  @@map("beds")
}

// What staff have deliberately withheld, one row per room type per night.
//
// **Nothing about this table is a count of reality.** Neither how many rooms
// exist nor how many are sold is stored here, for one reason: a cached count
// drifts the first time somebody adds a room or a channel cancels, and a wrong
// count here is an overbooking.
//
// - *Sold* is derived from the stays that occupy the night.
// - *Total* is derived from the `Room` rows of that type — it is a fact about
//   rows in another table, and storing a second copy of it was a bug: a
//   property set up through the app had no rows at all and was therefore sold
//   out on every night for ever.
//
// So **a night with no row is every room, nothing withheld** — the sane
// default, and the one that needs no horizon to be declared in advance. A row
// exists only where somebody held rooms back: allotment kept off the channels,
// a floor closed for a refit, a block a manager typed.
//
// What a channel manager is pushed is `total - blocked - sold`, computed at
// push time from all three.
model RoomTypeInventory {
  id           Int      @id @default(autoincrement())
  roomTypeId   Int
  date         DateTime
  blockedRooms Int      @default(0)
  // Why they were held back, for the person who finds the row in March and
  // cannot remember. Free text: the reasons do not enumerate.
  reason       String?
  updatedAt    DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@map("room_type_inventory")
}

// A slot held while someone is still paying.
//
// A uniqueness or exclusion constraint refuses the *second writer*; a hold
// stops the second guest ever reaching the payment page. `releaseAt` is what
// makes an abandoned checkout give the room back without a human.
model InventoryHold {
  id         Int      @id @default(autoincrement())
  roomTypeId Int
  checkIn    DateTime
  checkOut   DateTime
  quantity   Int      @default(1)
  // The checkout session this hold belongs to; unique so a refresh re-uses it
  // rather than holding a second room.
  holdKey    String   @unique
  releaseAt  DateTime
  createdAt  DateTime @default(now())

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, checkIn, checkOut])
  @@index([releaseAt])
  @@map("inventory_holds")
}
